# Copy to .env and fill in. Do NOT commit .env.

# Optional: an n8n (or any) webhook URL to also receive waitlist leads.
# If unset, leads are still saved to the volume file (LEADS_FILE).
WAITLIST_WEBHOOK_URL=

# Where JSON data (leads, users, progress) is stored. Mounted as a Docker volume.
DATA_DIR=/data
LEADS_FILE=/data/leads.jsonl

# Portal auth. SESSION_SECRET: a long random string (e.g., `openssl rand -hex 32`).
# ADMIN_TOKEN: a secret used to create learner accounts via POST /api/admin/users.
#   It also unlocks GET /api/coursebook/teacher for scripted access, so treat it
#   as a credential for the Teacher's Edition too.
SESSION_SECRET=
ADMIN_TOKEN=

# The coursebook PDFs are NOT public files. They live in web/private/coursebook/
# and are served by /api/coursebook/[edition]:
#   student -> any signed-in learner
#   teacher -> a user with role "teacher", or the ADMIN_TOKEN header
# Create a teacher by passing "role":"teacher" to POST /api/admin/users. To promote
# an existing account, set "role":"teacher" on their object in $DATA_DIR/users.json.
# No extra env var is needed for this.
